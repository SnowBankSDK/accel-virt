accel-virt: VK_EXT_image_drm_format_modifier where the driver has it. The
embedder makes the Direct3D 12 view of a texture another API on the GPU shares
(a Direct3D 11 shared texture, the rows a guest lends across adapters) as an
image of this device over the same dma-buf, under the explicit modifier and
layout the memory was made with, and hands it in as a borrowed resource. Such
an image needs the extension enabled on the device that makes it.

diff --git a/libs/vkd3d/device.c b/libs/vkd3d/device.c
index 6623eaf..a9fbe7c 100644
--- a/libs/vkd3d/device.c
+++ b/libs/vkd3d/device.c
@@ -114,6 +114,7 @@ static const struct vkd3d_optional_extension_info optional_device_extensions[] =
     VK_EXTENSION(EXT_EXTERNAL_MEMORY_HOST, EXT_external_memory_host),
     VK_EXTENSION(KHR_EXTERNAL_MEMORY_FD, KHR_external_memory_fd),
     VK_EXTENSION(EXT_EXTERNAL_MEMORY_DMA_BUF, EXT_external_memory_dma_buf),
+    VK_EXTENSION(EXT_IMAGE_DRM_FORMAT_MODIFIER, EXT_image_drm_format_modifier),
     VK_EXTENSION(KHR_EXTERNAL_SEMAPHORE_FD, KHR_external_semaphore_fd),
     VK_EXTENSION(EXT_SHADER_IMAGE_ATOMIC_INT64, EXT_shader_image_atomic_int64),
     VK_EXTENSION(EXT_MESH_SHADER, EXT_mesh_shader),
diff --git a/libs/vkd3d/vkd3d_private.h b/libs/vkd3d/vkd3d_private.h
index e159a03..6326f39 100644
--- a/libs/vkd3d/vkd3d_private.h
+++ b/libs/vkd3d/vkd3d_private.h
@@ -170,6 +170,7 @@ struct vkd3d_vulkan_info
     bool EXT_external_memory_host;
     bool KHR_external_memory_fd;
     bool EXT_external_memory_dma_buf;
+    bool EXT_image_drm_format_modifier;
     bool KHR_external_semaphore_fd;
     bool EXT_shader_image_atomic_int64;
     bool EXT_mesh_shader;
