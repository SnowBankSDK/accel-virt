From: accel-virt
Subject: [PATCH] a pixel shader that runs per sample reads its plain inputs at the pixel centre

A pixel shader whose input signature has the sample index, or any input
declared with sample interpolation, runs once per sample. Direct3D still
evaluates an input declared linear at the pixel centre and one declared
centroid at the centroid; only inputs declared sample are evaluated at the
sample. Vulkan leaves the location of an undecorated input of a shader that
runs per sample to the implementation, and some pick the sample. In such a
shader a floating point user input that is not declared flat or sample is now
read through InterpolateAtOffset with a zero offset, or InterpolateAtCentroid
when it is declared centroid. Shaders that run per pixel are unchanged.
---
diff --git a/dxil_converter.cpp b/dxil_converter.cpp
index 40ba5f8..519bfaa 100644
--- a/dxil_converter.cpp
+++ b/dxil_converter.cpp
@@ -5631,6 +5631,20 @@ bool Converter::Impl::emit_stage_input_variables()
 	if (auto_patch_location)
 		patch_location_offset = 0;
 
+	bool runs_per_sample = false;
+	if (execution_model == spv::ExecutionModelFragment)
+	{
+		for (unsigned i = 0; i < inputs_node->getNumOperands(); i++)
+		{
+			auto *input = llvm::cast<llvm::MDNode>(inputs_node->getOperand(i));
+			auto declared_value = static_cast<DXIL::Semantic>(get_constant_metadata(input, 3));
+			auto declared_mode = static_cast<DXIL::InterpolationMode>(get_constant_metadata(input, 5));
+			runs_per_sample = runs_per_sample || declared_value == DXIL::Semantic::SampleIndex ||
+			                  declared_mode == DXIL::InterpolationMode::LinearSample ||
+			                  declared_mode == DXIL::InterpolationMode::LinearNoperspectiveSample;
+		}
+	}
+
 	for (unsigned i = 0; i < inputs_node->getNumOperands(); i++)
 	{
 		bool arrayed_input = stage_arrayed_inputs;
@@ -5710,6 +5724,18 @@ bool Converter::Impl::emit_stage_input_variables()
 
 		bool per_vertex = llvm_attribute_at_vertex_indices.count(element_id) != 0;
 
+		if (runs_per_sample && !per_vertex && system_value == DXIL::Semantic::User &&
+		    effective_element_type == DXIL::ComponentType::F32)
+		{
+			if (interpolation == DXIL::InterpolationMode::Undefined ||
+			    interpolation == DXIL::InterpolationMode::Linear ||
+			    interpolation == DXIL::InterpolationMode::LinearNoperspective)
+				input_pixel_interpolation[element_id] = GLSLstd450InterpolateAtOffset;
+			else if (interpolation == DXIL::InterpolationMode::LinearCentroid ||
+			         interpolation == DXIL::InterpolationMode::LinearNoperspectiveCentroid)
+				input_pixel_interpolation[element_id] = GLSLstd450InterpolateAtCentroid;
+		}
+
 		if (arrayed_input)
 		{
 			type_id =
