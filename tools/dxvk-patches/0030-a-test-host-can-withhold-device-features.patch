From: accel-virt
Subject: [PATCH] a test host can withhold device features from DXVK

AV_TEST_HOST_WITHOUT names features the device is created without, read once when the
device capabilities are gathered, so a test on a host that has a feature runs the path
of a host that lacks it. Draws pay nothing for it.
---
diff --git a/src/dxvk/dxvk_device_info.cpp b/src/dxvk/dxvk_device_info.cpp
index 3578bbe..e9f0ae3 100644
--- a/src/dxvk/dxvk_device_info.cpp
+++ b/src/dxvk/dxvk_device_info.cpp
@@ -610,6 +610,14 @@ namespace dxvk {
       m_featuresSupported.extLineRasterization.smoothLines = VK_FALSE;
     }
 
+    std::string withheld = env::getEnvVar("AV_TEST_HOST_WITHOUT");
+
+    if (withheld.find("fragmentShaderBarycentric") != std::string::npos)
+      m_featuresSupported.khrFragmentShaderBarycentric.fragmentShaderBarycentric = VK_FALSE;
+
+    if (withheld.find("smoothLines") != std::string::npos)
+      m_featuresSupported.extLineRasterization.smoothLines = VK_FALSE;
+
     // Apply raw access chain option
     if (!instance.options().enableNvRawAccessChains)
       m_featuresSupported.nvRawAccessChains.shaderRawAccessChains = VK_FALSE;
