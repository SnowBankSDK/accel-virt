From: accel-virt
Subject: [PATCH] memory: the embedder asks every allocator to return its empty chunks when a take is refused

The gate gains relieveBy: each DxvkMemoryAllocator registers a callback
that frees the empty chunks of every heap. When any user of the same video
memory or host RAM budget (another DXVK device, vkd3d, the embedder's
Vulkan or OpenCL backends) is refused, the embedder calls the callbacks of
the other accounts and asks once more, so memory DXVK keeps for reuse does
not refuse another API. The callback only tries the allocator lock: an
allocator that is busy is allocating and returns its chunks itself.
---
diff --git a/src/dxvk/dxvk_memory.cpp b/src/dxvk/dxvk_memory.cpp
index 37113eb..4efc846 100644
--- a/src/dxvk/dxvk_memory.cpp
+++ b/src/dxvk/dxvk_memory.cpp
@@ -782,10 +782,14 @@ namespace dxvk {
     determineBufferUsageFlagsPerMemoryType();
 
     updateMemoryHeapBudgets();
+
+    m_vramAccount.relieveBy(&DxvkMemoryAllocator::relieveEmbedder, this);
   }
   
   
   DxvkMemoryAllocator::~DxvkMemoryAllocator() {
+    m_vramAccount.relieveBy(nullptr, nullptr);
+
     auto vk = m_device->vkd();
 
     // Free all resources that are still queued up for relocation
@@ -1774,6 +1778,22 @@ namespace dxvk {
   }
 
 
+  void DxvkMemoryAllocator::relieveEmbedder(void* holder) {
+    static_cast<DxvkMemoryAllocator*>(holder)->freeAllEmptyChunks();
+  }
+
+
+  void DxvkMemoryAllocator::freeAllEmptyChunks() {
+    std::unique_lock lock(m_mutex, std::try_to_lock);
+
+    if (!lock.owns_lock())
+      return;
+
+    for (uint32_t i = 0; i < m_memHeapCount; i++)
+      freeEmptyChunksInHeap(m_memHeaps[i], VkDeviceSize(-1), high_resolution_clock::time_point());
+  }
+
+
   void DxvkMemoryAllocator::freeEmptyChunksInHeap(
     const DxvkMemoryHeap&       heap,
           VkDeviceSize          allocationSize,
diff --git a/src/dxvk/dxvk_memory.h b/src/dxvk/dxvk_memory.h
index a73b2b7..8fe775e 100644
--- a/src/dxvk/dxvk_memory.h
+++ b/src/dxvk/dxvk_memory.h
@@ -1451,6 +1451,10 @@ namespace dxvk {
     uint32_t countEmptyChunksInPool(
       const DxvkMemoryPool&       pool) const;
 
+    static void relieveEmbedder(void* holder);
+
+    void freeAllEmptyChunks();
+
     void freeEmptyChunksInHeap(
       const DxvkMemoryHeap&       heap,
             VkDeviceSize          allocationSize,
diff --git a/src/dxvk/dxvk_vram_gate.h b/src/dxvk/dxvk_vram_gate.h
index c90fafa..5c3967a 100644
--- a/src/dxvk/dxvk_vram_gate.h
+++ b/src/dxvk/dxvk_vram_gate.h
@@ -26,6 +26,7 @@ namespace dxvk {
     uint64_t (*cap)(void* account);
     int      (*takeHost)(void* account, uint64_t bytes);
     void     (*giveHost)(void* account, uint64_t bytes);
+    void     (*relieveBy)(void* self, void* account, void (*relieve)(void* holder), void* holder);
   };
 
   inline const DxvkVramGate* g_vramGate = nullptr;
@@ -84,6 +85,11 @@ namespace dxvk {
         m_gate->giveHost(m_account, bytes);
     }
 
+    void relieveBy(void (*relieve)(void* holder), void* holder) const {
+      if (m_account)
+        m_gate->relieveBy(m_gate->self, m_account, relieve, holder);
+    }
+
   private:
 
     const DxvkVramGate* m_gate    = nullptr;
