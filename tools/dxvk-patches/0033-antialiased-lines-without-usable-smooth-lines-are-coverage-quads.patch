From: accel-virt
Subject: [PATCH] Direct3D 11 antialiased lines on a host without usable smooth lines are quads whose coverage the pixel shader puts in alpha

A Direct3D 10 or 11 line drawn with AntialiasedLineEnable and without MultisampleEnable, on a
device whose smooth lines are absent or unusable (RADV caps their coverage at a quarter, so its
smoothLines is cleared), goes through a geometry stage made by the shared line coverage
generator: each line becomes a quad 2.4 pixels across carrying its distance from the line, and
the pixel shader multiplies the alpha of render target 0 by the coverage of a 1.4 pixel wide
line at that distance. The stage reads the size of viewport 0 from its push data, written with
the draw. Lines from an application geometry shader, or from a stage writing the layer, the
viewport index or stream output, are drawn aliased and logged. Other draws pay nothing.
---
diff --git a/src/d3d11/d3d11_context.cpp b/src/d3d11/d3d11_context.cpp
index c207990..0ef5ddc 100644
--- a/src/d3d11/d3d11_context.cpp
+++ b/src/d3d11/d3d11_context.cpp
@@ -3563,6 +3563,9 @@ namespace dxvk {
 
     D3D11TirDraw draw = DetermineTargetIndependentRasterization();
 
+    if (draw.gs == nullptr)
+      draw = DetermineLineCoverage();
+
     if (draw.gs != nullptr) {
       if (unlikely(draw.gs->needsCompile()))
         m_device->requestCompileShader(draw.gs);
@@ -3658,6 +3661,66 @@ namespace dxvk {
   }
 
 
+  template<typename ContextType>
+  D3D11TirDraw D3D11CommonContext<ContextType>::DetermineLineCoverage() {
+    D3D11TirDraw draw = { };
+
+    auto rs = m_state.rs.state.ptr();
+
+    if (likely(!rs || !rs->EmulatesLineCoverage()))
+      return draw;
+
+    D3D11_PRIMITIVE_TOPOLOGY topology = m_state.ia.primitiveTopology;
+
+    bool adjacency = topology == D3D11_PRIMITIVE_TOPOLOGY_LINELIST_ADJ
+                  || topology == D3D11_PRIMITIVE_TOPOLOGY_LINESTRIP_ADJ;
+
+    bool lines = adjacency
+              || topology == D3D11_PRIMITIVE_TOPOLOGY_LINELIST
+              || topology == D3D11_PRIMITIVE_TOPOLOGY_LINESTRIP;
+
+    if (m_state.ds != nullptr) {
+      adjacency = false;
+      lines = m_state.ds->GetCommonShader()->GetShader()->metadata().outputTopology
+        == VK_PRIMITIVE_TOPOLOGY_LINE_LIST;
+
+      if (m_state.hs != nullptr && m_state.hs->GetCommonShader()->GetShader()->metadata()
+          .flags.test(DxvkShaderFlag::TessellationPoints))
+        lines = false;
+    }
+
+    if (!lines || m_state.vs == nullptr || m_state.ps == nullptr || !m_state.rs.numViewports)
+      return draw;
+
+    if (m_state.gs != nullptr) {
+      static bool s_warned = false;
+
+      if (!std::exchange(s_warned, true))
+        Logger::warn("D3D11: Antialiased lines from a geometry shader are drawn aliased");
+
+      return draw;
+    }
+
+    auto prevStage = m_state.ds != nullptr
+      ? m_state.ds->GetCommonShader()->GetShader()
+      : m_state.vs->GetCommonShader()->GetShader();
+
+    auto shaders = m_parent->GetLineCoverage().GetShaders(prevStage,
+      m_state.ps->GetCommonShader()->GetShader(), adjacency);
+
+    if (shaders.gs == nullptr)
+      return draw;
+
+    draw.gs = shaders.gs;
+    draw.ps = shaders.ps;
+    draw.rs = rs->GetLineCoverageState();
+
+    const auto& vp = m_state.rs.viewports[0u];
+    draw.viewport = {{ vp.TopLeftX, vp.TopLeftY, vp.Width, vp.Height }};
+    return draw;
+  }
+
+
   template<typename ContextType>
   void D3D11CommonContext<ContextType>::BatchDraw(
     const VkDrawIndirectCommand&            draw) {
